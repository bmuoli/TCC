:apply></ml:define></math><rendering item-idref="207"/></region><region region-id="2483" left="12" top="7614.0" width="525" height="36" align-x="12" align-y="7632.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">A malha externa utiliza a corrente regulada pela malha interna.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">P = vo²/Rload; p̂ = (2·Vo/Rload)·v̂o.</p></text></region><region region-id="2484" left="12" top="7674.0" width="525" height="68" align-x="12" align-y="7708.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:function><ml:id xml:space="preserve">Gp</ml:id><ml:boundVars><ml:id xml:space="preserve">p</ml:id></ml:boundVars></ml:function><ml:apply><ml:div/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">Vo</ml:id></ml:apply><ml:apply><ml:id xml:space="preserve">Ti</ml:id><ml:id xml:space="preserve">p</ml:id></ml:apply></ml:apply><ml:apply><ml:plus/><ml:real>1</ml:real><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:id xml:space="preserve">Rload</ml:id><ml:id xml:space="preserve">C2</ml:id></ml:apply><ml:id xml:space="preserve">p</ml:id></ml:apply></ml:apply></ml:apply></ml:define></math><rendering item-idref="208"/></region><region region-id="2485" left="12" top="7758.0" width="525" height="36" align-x="12" align-y="7776.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Potência: |Cp(jωcp)·Gp(jωcp)| = 1; |Gp(jωcp)| = 70,9378 W/A.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Limites: iref de 0 a 24 A; comando do PWM de 0,05 a 0,95.</p></text></region><region region-id="2486" left="12" top="7818.0" width="525" height="72" align-x="12" align-y="7854.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Kpp</ml:id><ml:eval><ml:apply><ml:div/><ml:real>1</ml:real><ml:apply><ml:mult/><ml:apply><ml:absval/><ml:apply><ml:id xml:space="preserve">Gp</ml:id><ml:apply><ml:mult/><ml:id xml:space="preserve">j</ml:id><ml:id xml:space="preserve">wcp</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:pow/><ml:parens><ml:apply><ml:plus/><ml:real>1</ml:real><ml:apply><ml:pow/><ml:parens><ml:apply><ml:div/><ml:id xml:space="preserve">wzp</ml:id><ml:id xml:space="preserve">wcp</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:parens><ml:real>0.5</ml:real></ml:apply></ml:apply></ml:apply></ml:eval></ml:define></math><rendering item-idref="209"/></region><region region-id="2487" left="12" top="7906.0" width="525" height="58" align-x="12" align-y="7935.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Kip</ml:id><ml:eval><ml:apply><ml:mult/><ml:id xml:space="preserve">Kpp</ml:id><ml:id xml:space="preserve">wzp</ml:id></ml:apply></ml:eval></ml:define></math><rendering item-idref="210"/></region><region region-id="2488" left="12" top="7980.0" width="525" height="58" align-x="12" align-y="8009.0" show-border="false" show-highlight="false" is-pro