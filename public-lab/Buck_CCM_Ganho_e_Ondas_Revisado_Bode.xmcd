><ml:mult/><ml:apply><ml:pow/><ml:real>10</ml:real><ml:real>-6</ml:real></ml:apply><ml:id xml:space="preserve">F</ml:id></ml:apply></ml:apply></ml:define></math><rendering item-idref="53"/></region><region region-id="2286" left="42" top="5121" width="450" height="260" align-x="42" align-y="5233.5" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><plot disable-calc="false" item-idref="54"/><rendering item-idref="55"/></region><region region-id="2287" left="12" top="5411" width="525" height="28" align-x="12" align-y="5438.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="true" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">O gráfico apresenta a capacitância mínima para o critério de ondulação indicado.</p></text></region><region region-id="2337" left="12" top="5451" width="525" height="28" align-x="12" align-y="5460.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Filtro de entrada — uma fase</p></text></region><region region-id="2338" left="12" top="5491" width="525" height="65" align-x="12" align-y="5508.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">f0f</ml:id><ml:apply><ml:mult/><ml:real>10</ml:real><ml:id xml:space="preserve">kHz</ml:id></ml:apply></ml:define></math><rendering item-idref="97"/></region><region region-id="2339" left="12" top="5568" width="525" height="65" align-x="12" align-y="5585.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Lfcalc</ml:id><ml:eval><ml:apply><ml:div/><ml:real>1</ml:real><ml:apply><ml:mult/><ml:apply><ml:pow/><ml:parens><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">π</ml:id></ml:apply><ml:id xml:space="preserve">f0f</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply><ml:id xml:space="preserve">C1</ml:id></ml:apply></ml:apply></ml:eval></ml:define></math><rendering item-idref="98"/></region><region region-id="2340" left="12" top="5645" width="525" height="65" align-x="12" align-y="5662.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Lf</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>50</ml:real><ml:apply><ml:pow/><ml:real>10</ml:real><ml:real>-6</ml:real></ml:apply></ml:apply><ml:id xml:space="preserve">H</ml:id></ml:apply></ml:define></math><rendering item-idref="99"/></region><region region-id="2341" left="12" top="5722" width="525" height="28" align-x="12" align-y="5731.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Lf calculado: 53,9 µH. Valor aproximado adotado: 50 µH.</p></text></region><region region-id="2458" left="12" top="5762.0" width="525" height="18" align-x="12" align-y="5771.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Dimensionamento dos PIs — corrente e potência</p></text></region><region region-id="2459" left="12" top="5804.0" width="525" height="90" align-x="12" align-y="5849.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Referência de potência: 375 W em uma fase; ponto nominal: 36 V.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">O PI de potência fornece iref. O PI de corrente comanda o PWM.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Modelo médio do estágio Buck, com entrada de 50 V após o filtro.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Portadora de 0 a 1, a 100 kHz; ganho do modulador unitário.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Fontes: Erickson e Maksimovic (2001), seção 9.5.2; Wang et al. (2026).</p></text></region><region region-id="2460" left="12" top="5918.0" width="525" height="58" align-x="12" align-y="5947.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Lc</ml:id><ml:apply><ml:mult/><ml:real>7e-05</ml:real><ml:id xml:space="preserve">H</ml:id></ml:apply></ml:define></math><rendering item-idref="189"/></region><region region-id="2461" left="12" top="5992.0" width="525" height="58" align-x="12" align-y="6021.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">rL</ml:id><ml:apply><ml:div/><ml:apply><ml:mult/><ml:real>0.028</ml:real><ml:id xml:space="preserve">V</ml:id></ml:apply><ml:id xml:space="preserve">A</ml:id></ml:apply></ml:define></math><rendering item-idref="190"/></region><region region-id="2462" left="12" top="6066.0" width="525" height="58" align-x="12" align-y="6095.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Rload</ml:id><ml:eval><ml:apply><ml:div/><ml:apply><ml:pow/><ml:id xml:space="preserve">Vo</ml:id><ml:real>2</ml:real></ml:apply><ml:id xml:space="preserve">Pfase</ml:id></ml:apply></ml:eval></ml:define></math><rendering item-idref="191"/></region><region region-id="2463" left="12" top="6140.0" width="525" height="54" align-x="12" align-y="6167.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Lc é a indutância de 70 µH do esquema usado na análise do controle.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">As seções anteriores conservam L = 75 µH, reaproveitado do Ćuk.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">rL = 28 mΩ representa a resistência série indicada no esquema.</p></text></region><region region-id="2464" left="12" top="6218.0" width="525" height="58" align-x="12" align-y="6247.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">j</ml:id><ml:apply><ml:pow/><ml:parens><ml:real>-1</ml:real></ml:parens><ml:parens><ml:apply><ml:div/><ml:real>1</ml:real><ml:real>2</ml:real></ml:apply></ml:parens></ml:apply></ml:define></math><rendering item-idref="192"/></region><region region-id="2465" left="12" top="6292.0" width="525" height="76" align-x="12" align-y="6330.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:function><ml:id xml:space="preserve">Gid</ml:id><ml:boundVars><ml:id xml:space="preserve">p</ml:id></ml:boundVars></ml:function><ml:apply><ml:div/><ml:apply><ml:mult/><ml:id xml:space="preserve">Vin</ml:id><ml:parens><ml:apply><ml:plus/><ml:apply><ml:mult/><ml:id xml:space="preserve">C2</ml:id><ml:id xml:space="preserve">p</ml:id></ml:apply><ml:apply><ml:div/><ml:real>1</ml:real><ml:id xml:space="preserve">Rload</ml:id></ml:apply></ml:apply></ml:parens></ml:apply><ml:apply><ml:plus/><ml:apply><ml:plus/><ml:apply><ml:plus/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:id xml:space="preserve">Lc</ml:id><ml:id xml:space="preserve">C2</ml:id></ml:apply><ml:apply><ml:pow/><ml:id xml:space="preserve">p</ml:id><ml:real>2</ml:real></ml:apply></ml:apply><ml:apply><ml:mult/><ml:parens><ml:apply><ml:plus/><ml:apply><ml:div/><ml:id xml:space="preserve">Lc</ml:id><ml:id xml:space="preserve">Rload</ml:id></ml:apply><ml:apply><ml:mult/><ml:id xml:space="preserve">rL</ml:id><ml:id xml:space="preserve">C2</ml:id></ml:apply></ml:apply></ml:parens><ml:id xml:space="preserve">p</ml:id></ml:apply></ml:apply><ml:real>1</ml:real></ml:apply><ml:apply><ml:div/><ml:id xml:space="preserve">rL</ml:id><ml:id xml:space="preserve">Rload</ml:id></ml:apply></ml:apply></ml:apply></ml:define></math><rendering item-idref="193"/></region><region region-id="2466" left="12" top="6384.0" width="525" height="54" align-x="12" align-y="6411.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Gid(p) = corrente no indutor / razão cíclica; p está em s⁻¹.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Critérios: corrente em fs/200 = 500 Hz; potência em 50 Hz.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Zeros: corrente em 750 Hz; potência em 50 Hz; margem mínima: 60°.</p></text></region><region region-id="2467" left="12" top="6462.0" width="525" height="58" align-x="12" align-y="6491.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">fci</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">fs</ml:id><ml:real>200</ml:real></ml:apply></ml:define></math><rendering item-idref="194"/></region><region region-id="2468" left="12" top="6536.0" width="525" height="58" align-x="12" align-y="6565.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">fzi</ml:id><ml:apply><ml:mult/><ml:real>1.5</ml:real><ml:id xml:space="preserve">fci</ml:id></ml:apply></ml:define></math><rendering item-idref="195"/></region><region region-id="2469" left="12" top="6610.0" width="525" height="58" align-x="12" align-y="6639.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">fcp</ml:id><ml:apply><ml:div/><ml:id xml:space="preserve">fci</ml:id><ml:real>10</ml:real></ml:apply></ml:define></math><rendering item-idref="196"/></region><region region-id="2470" left="12" top="6684.0" width="525" height="58" align-x="12" align-y="6713.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">fzp</ml:id><ml:id xml:space="preserve">fcp</ml:id></ml:define></math><rendering item-idref="197"/></region><region region-id="2471" left="12" top="6758.0" width="525" height="58" align-x="12" align-y="6787.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">wci</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">π</ml:id></ml:apply><ml:id xml:space="preserve">fci</ml:id></ml:apply></ml:define></math><rendering item-idref="198"/></region><region region-id="2472" left="12" top="6832.0" width="525" height="58" align-x="12" align-y="6861.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">wzi</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">π</ml:id></ml:apply><ml:id xml:space="preserve">fzi</ml:id></ml:apply></ml:define></math><rendering item-idref="199"/></region><region region-id="2473" left="12" top="6906.0" width="525" height="58" align-x="12" align-y="6935.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">wcp</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">π</ml:id></ml:apply><ml:id xml:space="preserve">fcp</ml:id></ml:apply></ml:define></math><rendering item-idref="200"/></region><region region-id="2474" left="12" top="6980.0" width="525" height="58" align-x="12" align-y="7009.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">wzp</ml:id><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:real>2</ml:real><ml:id xml:space="preserve">π</ml:id></ml:apply><ml:id xml:space="preserve">fzp</ml:id></ml:apply></ml:define></math><rendering item-idref="201"/></region><region region-id="2475" left="12" top="7054.0" width="525" height="18" align-x="12" align-y="7063.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Corrente: |Ci(jωci)·Gid(jωci)| = 1; |Gid(jωci)| = 14,3872 A.</p></text></region><region region-id="2476" left="12" top="7096.0" width="525" height="72" align-x="12" align-y="7132.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Kpi</ml:id><ml:eval><ml:apply><ml:div/><ml:real>1</ml:real><ml:apply><ml:mult/><ml:apply><ml:absval/><ml:apply><ml:id xml:space="preserve">Gid</ml:id><ml:apply><ml:mult/><ml:id xml:space="preserve">j</ml:id><ml:id xml:space="preserve">wci</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:pow/><ml:parens><ml:apply><ml:plus/><ml:real>1</ml:real><ml:apply><ml:pow/><ml:parens><ml:apply><ml:div/><ml:id xml:space="preserve">wzi</ml:id><ml:id xml:space="preserve">wci</ml:id></ml:apply></ml:parens><ml:real>2</ml:real></ml:apply></ml:apply></ml:parens><ml:real>0.5</ml:real></ml:apply></ml:apply></ml:apply></ml:eval></ml:define></math><rendering item-idref="202"/></region><region region-id="2477" left="12" top="7184.0" width="525" height="58" align-x="12" align-y="7213.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Kii</ml:id><ml:eval><ml:apply><ml:mult/><ml:id xml:space="preserve">Kpi</ml:id><ml:id xml:space="preserve">wzi</ml:id></ml:apply></ml:eval></ml:define></math><rendering item-idref="203"/></region><region region-id="2478" left="12" top="7258.0" width="525" height="58" align-x="12" align-y="7287.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define><ml:id xml:space="preserve">Tpi</ml:id><ml:eval><ml:apply><ml:div/><ml:id xml:space="preserve">Kpi</ml:id><ml:id xml:space="preserve">Kii</ml:id></ml:apply></ml:eval></ml:define></math><rendering item-idref="204"/></region><region region-id="2479" left="12" top="7332.0" width="525" height="36" align-x="12" align-y="7350.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Kpi = 0,0385550 A⁻¹; Kii = 181,6863 (A·s)⁻¹.</p><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Campos do PSIM: Gain = Kpi; Time Constant = Tpi = 212,2