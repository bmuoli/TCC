				<region region-id="1237" left="54" top="8480.25" width="357.75" height="24" align-x="60.75" align-y="8490" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Por causa da equação do ganho você pode substituir Vin e Vout nas equações por fórmulas que dependam de Vout , D e Vin , D respectivamente. Isso pode ser útil!</p>
					</text>
				</region>
				<region region-id="1239" left="54" top="8524.5" width="212.25" height="50.25" align-x="109.5" align-y="8544" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="2">Exemplo_L</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="out">V</ml:id>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:real>1</ml:real>
													<ml:id xml:space="preserve">D</ml:id>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:id xml:space="preserve">T</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult style="auto-select"/>
											<ml:real>40</ml:real>
											<ml:id xml:space="preserve">%</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve">P</ml:id>
											<ml:id xml:space="preserve" subscript="out">V</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>3.4883720930232556E-05</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="henry"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<engineering use-e-notation="false" precision="3" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="true" simplify-units="true" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
					<rendering item-idref="117"/>
				</region>
				<region region-id="1243" left="60" top="8606.25" width="219" height="12" align-x="63" align-y="8616" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">A mesma lógica que foi aplicada acima serve aqui:</p>
					</text>
				</region>
				<region region-id="1222" left="54" top="8661" width="150" height="16.5" align-x="116.25" align-y="8670" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="C1">Exemplo_V</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:plus/>
									<ml:id xml:space="preserve" subscript="in">V</ml:id>
									<ml:id xml:space="preserve" subscript="out">V</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>86</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="volt"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
					<rendering item-idref="118"/>
				</region>
				<region region-id="1240" left="54" top="8703" width="152.25" height="16.5" align-x="124.5" align-y="8712" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="C1">Exemplo_ΔV</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult style="auto-select"/>
										<ml:real>10</ml:real>
										<ml:id xml:space="preserve">%</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="C1">V</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>8.6</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="volt"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
					<rendering item-idref="119"/>
				</region>
				<region region-id="1241" left="54" top="8733" width="151.5" height="16.5" align-x="127.5" align-y="8742" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="out">Exemplo_ΔV</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult style="auto-select"/>
										<ml:real>10</ml:real>
										<ml:id xml:space="preserve">%</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="out">V</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>5</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="volt"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
					<rendering item-idref="120"/>
				</region>
				<region region-id="1245" left="54" top="8768.25" width="381.75" height="36" align-x="70.5" align-y="8778" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Cuidado para não enxer o TCC com esses gráficos. Mas você vai perceber que eles ajudam a justuficar algumas escolhas de projeto ao mesmo tempo que tornam a análise mais visual.</p>
					</text>
				</region>
			</area>
			<rendering item-idref="121"/>
		</region>
		<region region-id="901" left="0" top="8895" width="6000" align-x="6000" align-y="8904" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="" height="710.25">
			<area is-collapsed="false" name="Gerador do txt de parâmetros" show-name="true" show-border="true" show-icon="true" show-timestamp="true" allow-expand="false" is-locked="false" timestamp="" top-lock-id="901" bottom-lock-id="902" bottom-tag="">
				<region region-id="926" left="6" top="8912.25" width="59.25" height="12" align-x="6" align-y="8922" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Crie os labels</p>
					</text>
				</region>
				<region region-id="948" left="18" top="8949" width="88.5" height="144.75" align-x="48" align-y="9024" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">labels</ml:id>
							<ml:matrix rows="9" cols="1">
								<ml:str xml:space="preserve">Vin =</ml:str>
								<ml:str xml:space="preserve">Vout =</ml:str>
								<ml:str xml:space="preserve">Cin =</ml:str>
								<ml:str xml:space="preserve">Lin =</ml:str>
								<ml:str xml:space="preserve">Lo =</ml:str>
								<ml:str xml:space="preserve">Cdc =</ml:str>
								<ml:str xml:space="preserve">D =</ml:str>
								<ml:str xml:space="preserve">f =</ml:str>
								<ml:str xml:space="preserve">R =</ml:str>
							</ml:matrix>
						</ml:define>
					</math>
					<rendering item-idref="122"/>
				</region>
				<region region-id="929" left="12" top="9098.25" width="327" height="12" align-x="12" align-y="9108" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Crie os valores em formato texto (retirando as unidades quando necessário)</p>
					</text>
				</region>
				<region region-id="951" left="18" top="9132" width="99" height="294.75" align-x="66" align-y="9282" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">txt_values</ml:id>
							<ml:matrix rows="9" cols="1">
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="in">V</ml:id>
										<ml:id xml:space="preserve">V</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="out">V</ml:id>
										<ml:id xml:space="preserve">V</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="1">C</ml:id>
										<ml:id xml:space="preserve">F</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="1">L</ml:id>
										<ml:id xml:space="preserve">H</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="2">L</ml:id>
										<ml:id xml:space="preserve">H</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="2">C</ml:id>
										<ml:id xml:space="preserve">F</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:id xml:space="preserve">D</ml:id>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="s">f</ml:id>
										<ml:id xml:space="preserve">Hz</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="o">R</ml:id>
										<ml:id xml:space="preserve">Ω</ml:id>
									</ml:apply>
								</ml:parens>
							</ml:matrix>
						</ml:define>
					</math>
					<rendering item-idref="123"/>
				</region>
				<region region-id="957" left="12" top="9452.25" width="158.25" height="12" align-x="12" align-y="9462" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Monte a matriz final para exportação</p>
					</text>
				</region>
				<region region-id="958" left="18" top="9483" width="153" height="12.75" align-x="51.75" align-y="9492" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">output</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">augment</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">labels</ml:id>
									<ml:id xml:space="preserve">txt_values</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
					<rendering item-idref="124"/>
				</region>
				<region region-id="965" left="42" top="9516" width="86.25" height="62.25" align-x="84" align-y="9516" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<component hide-arguments="false" clsid-buddy="01350084-1122-11DB-9380-000D56C6051A" item-idref="125" disable-calc="false">
						<inputs>
							<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">output</ml:id>
						</inputs>
						<outputs/>
					</component>
					<rendering item-idref="126"/>
				</region>
				<region region-id="968" left="138" top="9524.25" width="368.25" height="12" align-x="147.75" align-y="9534" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">&lt;- Edite as propriedades do bloco para alterar o caminho onde o arquivo vai ser salvo</p>
					</text>
				</region>
				<region region-id="1251" left="168" top="9560.25" width="335.25" height="12" align-x="172.5" align-y="9570" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Se não estiver calculando/gerando seu arquivo é só pressionar Ctrl+F9</p>
					</text>
				</region>
			</area>
			<rendering item-idref="127"/>
		</region>
	</regions>
