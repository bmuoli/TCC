		<region region-id="61" left="78" top="1262.25" width="164.25" height="72" align-x="78" align-y="1272" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">O indutor então fica assim especificado:</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<f family="Arial" charset="0">
						<b>
							<inlineAttr line-through="false">L1 = 500mH</inlineAttr>
						</b>
					</f>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<f family="Arial" charset="0">
						<b>
							<inlineAttr line-through="false">Núcleo </inlineAttr>
						</b>
					</f>EE-42/21/15<f family="Arial" charset="0">
						<b>
							<inlineAttr line-through="false"> Thorton</inlineAttr>
						</b>
					</f>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<f family="Arial" charset="0">
						<b>
							<inlineAttr line-through="false">85 espiras</inlineAttr>
						</b>
					</f>
				</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
					<inlineAttr line-through="false">
						<f family="Arial" charset="0">
							<b>cabo 1x18 AWG</b>
						</f>
					</inlineAttr>
				</p>
			</text>
		</region>
	</regions>
