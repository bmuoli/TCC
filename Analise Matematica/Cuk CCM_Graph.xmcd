						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Aonde tiver <region region-id="1229" left="108" top="8301" width="18.75" height="16.5" align-x="116.25" align-y="8310" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
