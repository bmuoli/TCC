				<region region-id="1327" left="630" top="3230.25" width="438" height="24" align-x="633" align-y="3240" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">A diferença desse gráfico para o anterior é que nesse a tensão de saída é constante e a de entrada é variavel. O anterior era o contrario.</p>
					</text>
				</region>
				<region region-id="1000" left="66" top="3483.75" width="276" height="54" align-x="181.5" align-y="3522" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="graph_100k">L</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="in_variable">V</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="in_variable">V</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="out">V</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve" subscript="in_variable">V</ml:id>
												<ml:id xml:space="preserve" subscript="out">V</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:apply>
									<ml:mult style="auto-select"/>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve" subscript="1">ΔL</ml:id>
										<ml:real>100</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">kHz</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
