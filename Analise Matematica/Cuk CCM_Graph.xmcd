								<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false"> você substitui por 40%*</inlineAttr>
							</f>
							<region region-id="1230" left="228" top="8294.25" width="17.25" height="31.5" align-x="234.75" align-y="8310" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
