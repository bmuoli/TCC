				<region region-id="1334" left="642" top="4312.5" width="197.25" height="35.25" align-x="744.75" align-y="4332" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="2graph150k">L</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="variable">D</ml:id>
