				<region region-id="1219" left="30" top="8216.25" width="409.5" height="24" align-x="39" align-y="8226" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Esse estudo dos gráficos pode ficar mais generalista ainda se você transformar as variaveis que são DeltaV e DeltaI nos seus respectivos valores. Ex:</p>
					</text>
				</region>
				<region region-id="1220" left="54" top="8277" width="147" height="16.5" align-x="116.25" align-y="8286" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="1">Exemplo_ΔL</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult style="auto-select"/>
										<ml:real>40</ml:real>
										<ml:id xml:space="preserve">%</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="in">I</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>8.3333333333333339</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
