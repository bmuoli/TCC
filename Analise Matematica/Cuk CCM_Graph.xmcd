				<region region-id="1162" left="42" top="3168" width="516" height="272.25" align-x="42" align-y="3168" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<plot disable-calc="false" item-idref="42"/>
